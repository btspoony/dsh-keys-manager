{
  "name": "dsh-keys-manager",
  "version": "0.2.7",
  "type": "module",
  "description": "Multi-key management for DSH providers: sticky per-session round-robin, retry failover, cooldown recovery, and searchable extra providers.",
  "repository": {
    "type": "git",
    "url": "https://github.com/btspoony/dsh-keys-manager"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "keys",
    "provider",
    "llm"
  ],
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./bundle/cordis.patch.yml": "./bundle/cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bundle",
    "locale",
    "icon.svg",
    "scripts",
    "!lib/omp-oauth/metafile.json",
    "!scripts/omp-oauth"
  ],
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "build": "node scripts/omp-oauth/build-oauth.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs && node scripts/verify-dist.mjs",
    "build:client": "tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "test": "vitest run",
    "release:prepare": "node scripts/prepare-release.mjs",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "^0.2.1-rc.2",
    "react": "^18.2.0"
  },
  "dependencies": {
    "dsh-llm-omp-transports": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@oh-my-pi/pi-ai": "18.12.3",
    "@oh-my-pi/pi-catalog": "18.12.3",
    "@oh-my-pi/pi-utils": "18.12.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1"
  }
}
