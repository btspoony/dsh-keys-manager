{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": true
  },
  "include": [
    "src",
    "tests",
    "scripts/omp-oauth"
  ],
  "exclude": [
    "src/client",
    "tests/client.test.ts"
  ]
}
